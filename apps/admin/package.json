{
  "name": "@jad/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AF Homes Ecofarm administration application.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jad/config": "workspace:*",
    "@jad/contracts": "workspace:*",
    "@jad/shared": "workspace:*",
    "@jad/ui": "workspace:*",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "^5.101.4",
    "jsqr": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "recharts": "3.10.1",
    "sweetalert2": "^11.26.25",
    "zod": "^4.4.3"
  },
  "comments": {
    "jsqr": "Browser-side QR DECODER for the redemption scanner. Decodes a camera frame locally; no frame and no image ever leaves the device, and the only thing sent to the API is the decoded opaque token. Chosen over a hosted scanner because uploading a frame of a member's card to a third party would be a disclosure, and over a heavyweight SDK because this is the only thing it would be used for."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
