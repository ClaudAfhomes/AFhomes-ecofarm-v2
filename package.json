{
  "name": "afhomes-ecofarm",
  "version": "0.0.0",
  "private": true,
  "description": "AF Homes Ecofarm platform monorepo.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc --noEmit -p supabase",
    "typecheck:deploy": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "check:env": "node scripts/check-env-isolation.mjs",
    "seed": "tsx supabase/seed.ts",
    "seed:demo": "tsx supabase/seed-demo.ts",
    "db:migrate": "tsx supabase/apply-migrations.ts",
    "bootstrap:superadmin": "tsx supabase/invite-superadmin.ts",
    "test:db": "tsx supabase/db-integration.ts",
    "test:db:local": "pnpm --filter @jad/db-testing install && pnpm --filter @jad/db-testing exec node scripts/test-db-local.mjs",
    "test:db:harness": "pnpm --filter @jad/db-testing install && pnpm --filter @jad/db-testing exec node scripts/test-db-harness.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "~5.9.3"
  }
}
