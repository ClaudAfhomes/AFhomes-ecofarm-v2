{
  "name": "afhomes-ecofarm",
  "version": "0.0.0",
  "private": true,
  "description": "AF Homes Ecofarm platform monorepo.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch api/scripts/dev-mongodb-admin.ts",
    "start:mongodb": "node --import tsx api/server.ts",
    "build:hosted": "tsx api/scripts/build-hosted.ts",
    "dev:mongodb:local": "tsx api/scripts/dev-mongodb-local.ts",
    "dev:mongodb:admin": "tsx api/scripts/dev-mongodb-admin.ts",
    "dev:search:local": "node packages/db-testing/scripts/preview-sale-team-search.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc --noEmit -p supabase",
    "typecheck:deploy": "turbo run typecheck",
    "test": "turbo run test --concurrency=1 -- --maxWorkers=1",
    "format": "prettier --write .",
    "check:env": "node scripts/check-env-isolation.mjs",
    "seed": "tsx supabase/seed.ts",
    "seed:demo": "tsx supabase/seed-demo.ts",
    "db:migrate": "tsx supabase/apply-migrations.ts",
    "db:prepare:local": "node packages/db-testing/scripts/prepare-local-supabase-migrations.mjs",
    "bootstrap:superadmin": "tsx supabase/invite-superadmin.ts",
    "test:db": "tsx supabase/db-integration.ts",
    "test:db:search": "node packages/db-testing/scripts/test-sale-team-search.mjs",
    "test:db:local": "pnpm --filter @afhomes/db-testing install && pnpm --filter @afhomes/db-testing exec node scripts/test-db-local.mjs",
    "test:db:harness": "pnpm --filter @afhomes/db-testing install && pnpm --filter @afhomes/db-testing exec node scripts/test-db-harness.mjs",
    "test:security:db": "node packages/db-testing/scripts/test-security-remediation.mjs --full",
    "test:mongodb:recovery": "pnpm --filter api exec vitest run _lib/testing/mongo-recovery.spec.ts --maxWorkers=1",
    "mongodb:ping": "tsx scripts/ping-mongodb.ts",
    "mongodb:validators": "tsx api/scripts/check-mongodb-validators.ts",
    "mongodb:core": "tsx api/scripts/prepare-mongodb-core.ts",
    "mongodb:catalog": "tsx api/scripts/prepare-mongodb-catalog.ts",
    "mongodb:bootstrap-admin": "tsx api/scripts/bootstrap-mongodb-admin.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "~5.9.3"
  }
}
