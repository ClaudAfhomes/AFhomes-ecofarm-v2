{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["_lib/**/*.ts", "_handlers/**/*.ts", "router.ts", "dev-server.ts", "server.ts", "scripts/build-hosted.ts", "scripts/check-mongodb-validators.ts"]
}
