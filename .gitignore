# Dependencies
node_modules/

# Build output
dist/
coverage/
vercel-static/

# Environment — secrets are never committed
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor/OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Vercel local dev config (not production)
vercel.local.json

# Turborepo
.turbo/

# Vitest
*.local

.vercel

# Local-only backfill rollback maps/snapshots (dev data, regenerated per run)
supabase/backfill-staff-domain.map.json
supabase/backfill-staff-domain.retire.json

# opencode agent skills (local-only, never commit or deploy)
.opencode/

# Local pnpm shim used so turbo can find the package manager (see AGENTS.md)
.tmp-bin/

# Supabase CLI local cache (project ref + pooler URL - connection metadata)
supabase/.temp/

# NOTE: a bare `.env*` used to sit here. Because the LAST matching pattern wins,
# it silently overrode the `!.env.example` negation above, so on a fresh clone
# the documented environment template was git-ignored and could never be added
# or updated - it only survived because it was already tracked. The explicit
# block at the top of this file is the single source of truth; do not re-add a
# blanket `.env*` here.
