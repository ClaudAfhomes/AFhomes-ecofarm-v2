# AF Homes Ecofarm v2. Values are placeholders only; never commit .env files.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_API_BASE_URL=/api/v1
VITE_WEB_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174/admin

# Server-only; never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-secret
DATABASE_URL=postgresql://postgres.PROJECT_REF:password@POOLER_HOST:6543/postgres
AFHOMES_TARGET_PROJECT_REF=your-project-ref
AFHOMES_SUPERADMIN_EMAIL=owner@example.com
AFHOMES_WEB_URL=http://localhost:5173
AFHOMES_ADMIN_URL=http://localhost:5174/admin
EMAIL_FROM=AF Homes <no-reply@example.com>
RESEND_API_KEY=your-server-secret
DOCUMENT_HASH_PEPPER=your-server-secret
# OCR_PROVIDER_URL=https://provider.example/v1/ocr
# OCR_PROVIDER_API_KEY=your-server-secret

# No Super Admin password variable exists. Bootstrap uses a Supabase Auth invitation.
# Preview demo seeding additionally requires AFHOMES_ALLOW_DEMO_SEED=true and a non-production project ref.
