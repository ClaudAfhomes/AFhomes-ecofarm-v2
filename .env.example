# AF Homes Ecofarm v2. Values are placeholders only; never commit .env files.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_API_BASE_URL=/api/v1
VITE_WEB_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174/admin

# Server-only; never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-secret
DATABASE_URL=postgresql://postgres.PROJECT_REF:password@POOLER_HOST:6543/postgres
AFHOMES_TARGET_PROJECT_REF=your-project-ref
AFHOMES_SUPERADMIN_EMAIL=owner@example.com
AFHOMES_WEB_URL=http://localhost:5173
AFHOMES_ADMIN_URL=http://localhost:5174/admin
EMAIL_FROM=AF Homes <no-reply@example.com>
RESEND_API_KEY=your-server-secret
# App-owned customer onboarding email. Supabase Auth SMTP does not send this
# custom token, so configure these separately in the server environment.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-server-email@example.com
SMTP_PASSWORD=your-server-app-password
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=AF Homes Ecofarm
DOCUMENT_HASH_PEPPER=your-server-secret
# OCR_PROVIDER_URL=https://provider.example/v1/ocr
# OCR_PROVIDER_API_KEY=your-server-secret

# No Super Admin password variable exists. Bootstrap uses a Supabase Auth invitation.
# Public sale-team search v2. Disabled until private schema, finalized notice,
# retention and scheduled cleanup are approved/configured. Never use test keys live.
AFHOMES_SEARCH_ENABLED=false
# AFHOMES_VERIFICATION_PHONE=+639604316867
# AFHOMES_SEARCH_SECRET=<stable-server-only-random-secret-at-least-32-characters>
# AFHOMES_SEARCH_TURNSTILE_SECRET=<server-only-widget-secret>
# AFHOMES_SEARCH_TURNSTILE_HOSTNAMES=<approved-comma-separated-hostnames>
# VITE_TURNSTILE_SITE_KEY=<public-widget-key>
# AFHOMES_SEARCH_NOTICE_VERSION=<approved-version>
# AFHOMES_SEARCH_PRIVACY_NOTICE=<finalized-complete-notice>
# AFHOMES_SEARCH_PRIVACY_APPROVED=true
# AFHOMES_SEARCH_CONTACT_RETENTION_DAYS=<owner-approved-positive-days>
# AFHOMES_SEARCH_CLEANUP_READY=true
# AFHOMES_SEARCH_LOCAL_PREVIEW=true is accepted only with loopback Supabase,
# outside production. Use the disposable preview script; do not point it at hosted data.
# Preview demo seeding additionally requires AFHOMES_ALLOW_DEMO_SEED=true and a non-production project ref.
# Super-admin test-account purge (POST staff/:id/purge-test-data) requires
# AFHOMES_ENABLE_TEST_PURGE=true. Set it ONLY in preview/development - the
# endpoint 404s without it, so production (unset) can never serve it.
