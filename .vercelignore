# Vercel upload exclusions.
# Critical: anything under api/ that is not `_`-prefixed becomes a function, so
# test files and the local dev server must be excluded from the upload.
**/*.spec.ts
**/*.spec.tsx
api/dev-server.ts
# Test-only harness (Supabase fake + fixtures). Never imported by production
# code; excluded so it cannot reach a deployment snapshot.
api/_lib/testing/

# Secrets / local env — NEVER upload. The CLI uploads by .vercelignore (gitignore
# is not consulted), so without these the root .env (service-role key, DATABASE_URL,
# admin/seed passwords) ships into every deployment snapshot.
.env
.env.*
!.env.example
.vercel/

# Not needed on the server
supabase/
supabase/.temp/
docs/
legacy/
.opencode/
.tmp-bin/
node_modules/
.turbo/
vercel-static/
package.json.bak
C：UsersSSD-OR~1AppDataLocalTemplint.txt

# Retired JAD dev scratch scripts (operated on the JAD `marketing-tools` bucket)
test-cleanup.ts
test-realtime.ts