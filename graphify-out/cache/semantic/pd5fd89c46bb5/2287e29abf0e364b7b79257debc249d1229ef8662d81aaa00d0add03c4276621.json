{"nodes": [{"id": "docs_business_rules_br_qlf_qualification", "label": "BR-QLF - Closed-Deal Qualification, Thresholds, Freezing, Reversals, Payout Stages", "file_type": "document", "source_file": "docs/business-rules/BR-QLF-qualification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_business_rules_br_qlf_qualification_br_qlf_01", "label": "BR-QLF-01 - Qualification is automatic on counted APPROVED collections", "file_type": "concept", "source_file": "docs/business-rules/BR-QLF-qualification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_business_rules_br_qlf_qualification_br_qlf_02", "label": "BR-QLF-02 - Thresholds: AFhomes VIP 25%, AFhomes IGP 10%, JA&D IGP 10%", "file_type": "concept", "source_file": "docs/business-rules/BR-QLF-qualification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Below the line a sale is a concession, still pending, not a closed deal; the thresholds are STRICTER than the contract text and were written into the DST contracts via the 21 Aug Addendum."}, {"id": "docs_business_rules_br_qlf_qualification_br_qlf_03", "label": "BR-QLF-03 - Qualification date freezes; threshold changes bind new qualifications only", "file_type": "concept", "source_file": "docs/business-rules/BR-QLF-qualification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lowering the line judges every not-yet-qualified sale live and is the most careful parameter: warn before acceptance, log abandonment; no retroactive re-judgement."}, {"id": "docs_business_rules_br_qlf_qualification_br_qlf_04", "label": "BR-QLF-04 - Refund removes qualification outright; replacement qualifies from zero", "file_type": "concept", "source_file": "docs/business-rules/BR-QLF-qualification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Qualification is judged PER TRANSACTION: a refund is not a slide down a percentage; UPGRADED/DOWNGRADED receipts move to the new number, CANCELLED receipts stay in collection totals as-cash."}, {"id": "docs_business_rules_br_qlf_qualification_br_qlf_05", "label": "BR-QLF-05 - Closed-deal gate and stage-1 payout gate are independent", "file_type": "concept", "source_file": "docs/business-rules/BR-QLF-qualification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Counts vs pays: a sale can be a closed deal and have paid out no commission; the two thresholds must never be conflated."}, {"id": "docs_business_rules_br_qlf_qualification_br_qlf_06", "label": "BR-QLF-06 - Qualified TCP renamed Closed Deal TCP (presentational)", "file_type": "concept", "source_file": "docs/business-rules/BR-QLF-qualification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_business_rules_br_qlf_qualification", "target": "docs_business_rules_br_qlf_qualification_br_qlf_01", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/business-rules/BR-QLF-qualification.md", "source_location": null, "weight": 1.0}, {"source": "docs_business_rules_br_qlf_qualification", "target": "docs_business_rules_br_qlf_qualification_br_qlf_02", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/business-rules/BR-QLF-qualification.md", "source_location": null, "weight": 1.0}, {"source": "docs_business_rules_br_qlf_qualification", "target": "docs_business_rules_br_qlf_qualification_br_qlf_03", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/business-rules/BR-QLF-qualification.md", "source_location": null, "w