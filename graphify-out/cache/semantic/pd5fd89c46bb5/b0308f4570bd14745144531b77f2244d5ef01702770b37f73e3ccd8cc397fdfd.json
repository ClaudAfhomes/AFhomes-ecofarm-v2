{"nodes": [{"id": "docs_afhomes_business_rules", "label": "AF Homes Business Rules \u2014 ID Generator and Numbering", "file_type": "document", "source_file": "docs/AFHOMES-BUSINESS-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_afhomes_business_rules_customer_number_format", "label": "AF-CUS-YYYY-NNNNNN Customer Number Format", "file_type": "concept", "rationale": "Format approved 2026-10-14 for printing only; issuance trigger, sequence policy, merges and legacy backfill stay blocked (OD-12). The document is not authorization to change production behavior.", "source_file": "docs/AFHOMES-BUSINESS-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_afhomes_business_rules_vip_control_number", "label": "AFhomes VIP Control Number (YYMMDDNNNNNVTPMMS)", "file_type": "concept", "source_file": "docs/AFHOMES-BUSINESS-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_afhomes_business_rules_igp_series_number", "label": "IGP Series Number (XYYMMDDNNNNTPMMS)", "file_type": "concept", "source_file": "docs/AFHOMES-BUSINESS-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_afhomes_business_rules_accreditation_number", "label": "AAI/AAO Accreditation Number", "file_type": "concept", "rationale": "Numbers are 11 characters and never renumbered, reused or reissued; an accreditation number is not proof of current validity.", "source_file": "docs/AFHOMES-BUSINESS-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_afhomes_business_rules_linked_sales_reference", "label": "Linked Sales Reference", "file_type": "concept", "rationale": "A display/reconciliation expression, not a distinct transaction \u2014 the immutable sale number is never replaced.", "source_file": "docs/AFHOMES-BUSINESS-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_afhomes_business_rules_od_01_sequence_scope", "label": "OD-01 Annual vs Monthly Sequence Scope (BLOCKER)", "file_type": "concept", "rationale": "Reference sheets say annual, but the actual Register formulas and FrozenMonthMaxG count same-year-and-month rows; management must approve the scope and nothing is silently chosen.", "source_file": "docs/AFHOMES-BUSINESS-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_afhomes_business_rules_od_02_accreditation_counter", "label": "OD-02 Accreditation Counter Scope (RESOLVED)", "file_type": "concept", "rationale": "One company-wide monthly sequence shared by the AAI and AAO prefixes; a kind change transfers the member to a fresh number of the new kind and retires the old number into accreditation history.", "source_file": "docs/AFHOMES-BUSINESS-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_afhomes_business_rules_od_12_customer_issuance", "label": "OD-12 Customer ID Issuance Decision", "file_type": "concept", "rationale": "Printed format resolved; issuance trigger, year-scoped vs lifetime allocation, duplicate merges and legacy aliases remain open \u2014 no production issuance until separately approved.", "source_file": "docs/AFHOMES-BUSINESS-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_afhomes_business_rules_identifier_registry_model", "label": "business_identifier_registry / Counters Model", "file_type": "concept", "source_file": "docs/AFHOMES-BUSINESS-RULES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs