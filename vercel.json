{
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "node scripts/prepare-vercel-env.mjs && pnpm exec turbo run build && node scripts/assemble-vercel-output.mjs",
  "outputDirectory": "vercel-static",
  "functions": {
    "api/router.ts": {
      "includeFiles": "packages/**"
    }
  },
  "crons": [
    {
      "path": "/health",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/router" },
    { "source": "/health", "destination": "/api/router?path=health" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
